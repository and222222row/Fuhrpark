        <script><![CDATA[(function executeAction(current) {
    var nutzung = new GlideRecord('x_1794162_fuhrpark_vehicle_usage');
    nutzung.addQuery('vehicle', current.sys_id);
    nutzung.addNullQuery('usage_end');
    nutzung.orderByDesc('usage_start'); // sicherstellen: jüngste Nutzung zuerst
    nutzung.setLimit(1);
    nutzung.query();

    if (nutzung.next()) {
        nutzung.usage_end = new GlideDateTime();
        nutzung.update();
        gs.addInfoMessage(gs.getMessage('vehicle_usage _successfully_ended'));
    } else {
        gs.addErrorMessage(gs.getMessage('no_active_vehicle_usage_found.'));
    }

    // optional: Status auf "Verfügbar" setzen
    //current.status = "Verfügbar";
    current.update();

    // Zurück zum Formular
    action.setRedirectURL(current);

})(current);]]></script>
