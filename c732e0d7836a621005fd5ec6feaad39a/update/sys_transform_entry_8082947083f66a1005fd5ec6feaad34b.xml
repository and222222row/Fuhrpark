        <source_script><![CDATA[answer = (function transformEntry(source) {

	// Add your code here
	var hersteller = source.u_kfz_hersteller.toString().trim();
    var bezeichnung = source.u_bezeichnung.toString().trim();
    
    var model = new GlideRecord('x_1794162_fuhrpark_vehicle_model'); 
    model.addQuery('manufacturer.name', hersteller); // Assuming manufacturer is a reference
    model.addQuery('name', bezeichnung);
    model.query();
	gs.info('hersteller : '+ hersteller);
	gs.info('bezeichnung : '+ bezeichnung);

    if (model.next()) {
        return model.sys_id;
    }
    return '';

})(source);]]></source_script>
